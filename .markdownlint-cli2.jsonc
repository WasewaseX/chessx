{
  // ChessX house config for the docs gate. Derived from the master-ci
  // template default; the pure blank-line / emphasis-style rules are off
  // because this repo's prose is journals (worklog.md) and pasted RE
  // analysis (docs/*), where those rules demand editorial rewrites with no
  // defect-catching value. Everything that catches REAL breakage stays on:
  // trailing whitespace, multiple consecutive blanks, blank line inside a
  // blockquote or list, missing final newline, unescaped emphasis-ish
  // content, broken list structure, bare-code-in-heading artifacts.
  "config": {
    "MD001": true,
    "MD004": false,
    "MD007": { "indent": 2 },
    "MD009": true,
    "MD010": true,
    "MD012": { "maximum": 3 },
    "MD013": false,
    "MD018": true,
    "MD019": true,
    "MD022": false,
    "MD023": true,
    "MD024": { "siblings_only": true },
    "MD025": false,
    "MD026": false,
    "MD028": true,
    "MD029": { "style": "one_or_ordered" },
    "MD030": false,
    "MD031": false,
    "MD032": false,
    "MD033": false,
    "MD034": false,
    "MD035": false,
    "MD036": false,
    "MD037": true,
    "MD038": true,
    "MD039": true,
    "MD040": false,
    "MD041": false,
    "MD042": true,
    "MD045": false,
    "MD046": false,
    "MD047": true,
    "MD049": { "style": "asterisk" },
    "MD050": { "style": "consistent" },
    "MD051": true,
    "MD052": true,
    "MD053": false,
    "MD054": false,
    "MD055": false,
    "MD056": false,
    "MD058": false,
    "MD059": false,
    "MD060": false
  },
  "globs": ["**/*.md"],
  "ignores": ["**/node_modules/**", "**/_ci/**", "**/dist/**", "**/build/**", "engine-native/**", "skills/**", "re/**", "download/**", "research/**", "agent-ctx/**",
    "docs/chessreps-re-report.md"]
}
