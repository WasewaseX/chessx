# ChessX environment (copy to .env and fill in). Never commit .env.
DATABASE_URL=file:./db/custom.db

# Optional: seed an initial admin account (create-only, never resets passwords).
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-8-chars-min

# Optional: master key for encrypting stored BYO AI keys at rest.
# If unset, a random key is generated and kept in db/.secret (gitignored).
# CHESSX_SECRET=

# Optional: allow private/loopback AI endpoints (local Ollama etc). Dev only.
# AI_ALLOW_PRIVATE_ENDPOINTS=1
