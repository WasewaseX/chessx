generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Registered account. Credentials only; all learning data hangs off Profile.
model User {
  id            String   @id @default(cuid())
  email         String   @unique // stored lowercase
  username      String // display form
  usernameLower String   @unique // case-insensitive uniqueness
  passwordHash  String // bcrypt for password accounts, "oauth:<random>" for Google-only accounts
  role          String   @default("user") // user | admin
  googleId      String?  @unique // Google account subject, set when linked
  createdAt     DateTime @default(now())

  sessions      Session[]
  tickets       SocketTicket[]
  ratings       UserRating[]
  gamesAsWhite  OnlineGame[]   @relation("gameWhite")
  gamesAsBlack  OnlineGame[]   @relation("gameBlack")
  profile       Profile?
  desktopHandoffTokens DesktopHandoffToken[]
}

// Server-side session store. The cookie holds a random token; the DB holds
// its SHA-256 hash, so a DB leak never yields usable cookies.
model Session {
  id        String   @id // sha256(token)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Short-lived single-use credential that lets the websocket service confirm
// who is connecting without ever exposing the session cookie to JS.
model SocketTicket {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Single-use bridge credential for the desktop shell's Google sign-in
// (RFC 8252 loopback handoff). The system browser finishes OAuth, mints one
// of these and bounces to the shell's loopback listener; the shell redeems
// it for a normal session. Only the SHA-256 of the token is stored, so the
// token in a redirect URL is useless to anyone who cannot also read the DB.
model DesktopHandoffToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// The single account Elo. Every rated online game moves it, whatever the
// time control; bot play and puzzles never touch it (they feed the separate
// potential estimate on Profile instead).
model UserRating {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pool       String // always 'overall'
  rating     Float     @default(400)
  rd         Float     @default(350)
  wins       Int       @default(0)
  losses     Int       @default(0)
  draws      Int       @default(0)
  games      Int       @default(0)
  lastGameAt DateTime?

  @@unique([userId, pool])
}

// A real online game between two accounts.
model OnlineGame {
  id          String    @id
  whiteId     String?
  white       User?     @relation("gameWhite", fields: [whiteId], references: [id], onDelete: SetNull)
  blackId     String?
  black       User?     @relation("gameBlack", fields: [blackId], references: [id], onDelete: SetNull)
  whiteName   String
  blackName   String
  pool        String // bullet | blitz | rapid
  initialSec  Int
  incSec      Int
  rated       Boolean   @default(true)
  result      String    @default("*") // "1-0" | "0-1" | "1/2-1/2" | "*"
  termination String? // checkmate | resignation | timeout | stalemate | agreement | repetition | insufficient | fifty | abandonment
  whiteDelta  Int?
  blackDelta  Int?
  whiteRating Float? // after the game
  blackRating Float?
  pgn         String    @default("")
  createdAt   DateTime  @default(now())
  endedAt     DateTime?

  @@index([whiteId])
  @@index([blackId])
}

model Profile {
  id             String   @id @default(cuid())
  userId         String?  @unique
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String   @default("Player")
  skillLevel     String   @default("beginner") // new | beginner | intermediate | advanced | expert
  coach          String   @default("") // chosen coach id, empty until the player picks one themselves
  onboarded      Boolean  @default(false)
  theme          String   @default("green") // board theme: green | brown | slate | walnut
  darkMode       String   @default("system") // light | dark | system
  soundEnabled   Boolean  @default(true)
  showCoords     Boolean  @default(true)
  showLegal      Boolean  @default(true)
  autoPromote    Boolean  @default(false)
  xp             Int      @default(0)
  // puzzle rating
  puzzleRating   Int?
  puzzleCount    Int      @default(0)
  puzzleStreak   Int      @default(0)
  bestPuzzleStreak Int    @default(0)
  puzzleSolved   Int      @default(0)
  puzzleFailed   Int      @default(0)
  dailyDoneDate  String?  // yyyy-mm-dd of last completed daily puzzle (user tz)
  // bot games are casual; they feed an estimated Elo exactly like chess.com
  // does for bot play: standard Elo (K=32) against each bot's fixed rating.
  botGames       Int      @default(0)
  botElo         Int      @default(0) // 0 until the first bot game seeds it
  botEloGames    Int      @default(0)
  // daily goal + rush bests
  goalMinutes    Int      @default(15)
  // streak freeze tokens: one banked per qualifying week (goal met 5 of the
  // last 7 days), max 2 held. A missed day consumes one and keeps the streak.
  streakFreezes  Int      @default(1)
  lastFreezeGrant String? // yyyy-mm-dd of the most recent freeze grant
  rushBest3m     Int      @default(0)
  rushBestSurvival Int    @default(0)
  // AI provider settings (BYO API)
  aiProvider     String   @default("builtin") // builtin | openai | anthropic | gemini | openrouter | groq | deepseek | custom
  aiBaseUrl      String?
  aiApiKey       String?
  aiModel        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  drills Drill[]
  dnaSnapshots DnaSnapshot[]
}

model GameRecord {
  id          String   @id @default(cuid())
  profileId   String   @default("me")
  color       String // w | b
  botLevel    Int // 1-14
  botName     String
  rated       Boolean  @default(false)
  result      String // win | loss | draw
  reason      String // checkmate | resign | stalemate | insufficient | repetition | fifty | agreement | abandoned
  pgn         String
  finalFen    String
  moveCount   Int
  ratingDelta Int?
  accuracy    Float?
  // game report v1: filled when the player runs a review on this game
  opening     String?
  whiteAcc    Float?
  blackAcc    Float?
  playerAcc   Float?
  labelsJson  String? // per-side label counts, {best:{w,b},...}
  localHour   Int? // player's local hour (0-23) when the game ended, for time-of-day insights
  // pivotal moment: the player's biggest verified eval drop, stored with the
  // position right before it so the coach can spin a drill from the exact miss
  pivotFen    String?
  pivotSan    String?
  pivotPly    Int?
  pivotLoss   Float? // centipawns thrown away
  analyzedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([profileId])
}

// Mistake Corrector: one stored error (Mistake / Blunder / Missed Win) from
// the player's own analyzed games, replay-until-mastered. Harvested from
// GameRecord.labelsJson callouts (FEN rebuilt by replaying the stored PGN) or
// saved directly from the Game review Key Moments list. bestSan is "" while
// the engine answer is still being resolved lazily; streakFails counts
// consecutive wrong answers this cycle (the 2nd consecutive failure reveals
// the solution); revealed marks that the answer was already shown, so a
// correct replay after a reveal no longer counts as first-try mastery.
model Drill {
  id           String   @id @default(cuid())
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  gameRecordId String? // the analyzed game it came from (null for hand-saved moments)
  fen          String // position BEFORE the error
  userSan      String // the bad move played in the game
  bestSan      String // what to find instead ("" while pending engine resolution)
  bestUci      String?
  evalLossCp   Int // how much the error cost, in centipawns
  plyNumber    Int // 0-based index of the bad move in the game's SAN list
  opening      String?
  opponent     String?
  note         String? // coach-style reason line from the stored report (revealed only after solve)
  mastered     Boolean  @default(false)
  attempts     Int      @default(0)
  fails        Int      @default(0)
  streakFails  Int      @default(0)
  revealed     Boolean  @default(false)
  nextDueAt    DateTime @default(now())
  createdAt    DateTime @default(now())

  @@unique([profileId, gameRecordId, plyNumber])
  @@index([profileId, nextDueAt])
}

model LessonProgress {
  id            String   @id @default(cuid())
  profileId     String   @default("me")
  lessonId      String
  completed     Boolean  @default(false)
  stepsDone     Int      @default(0)
  totalSteps    Int      @default(0)
  hintsUsed     Int      @default(0)
  completedAt   DateTime?
  updatedAt     DateTime @updatedAt

  @@unique([profileId, lessonId])
}

model PuzzleAttempt {
  id         String   @id @default(cuid())
  profileId  String   @default("me")
  puzzleId   String
  kind       String   @default("rated") // rated | daily | review
  solved     Boolean
  ratingDelta Int?
  dayKey     String? // for daily: yyyy-mm-dd
  createdAt  DateTime @default(now())

  @@index([profileId])
}

// One row per calendar day the player was active. id is (profileId + dayKey).
model ActivityDay {
  id            String   @id // profileId:yyyy-mm-dd (user tz)
  profileId     String   @default("me")
  dayKey        String   // yyyy-mm-dd (user tz)
  minutes       Int      @default(0) // active minutes, heartbeats from the client
  puzzlesSolved Int      @default(0)
  lessonSteps   Int      @default(0)
  gamesPlayed   Int      @default(0)
  goalMet       Boolean  @default(false)
  frozen        Boolean  @default(false) // a streak freeze covered this missed day: chain continues, count does not grow
  updatedAt     DateTime @updatedAt

  @@index([profileId])
  @@index([profileId, dayKey])
}

// Completed Puzzle Rush runs.
model RushRun {
  id        String   @id @default(cuid())
  profileId String   @default("me")
  mode      String // threeMin | survival
  score     Int
  total     Int
  seconds   Int
  dayKey    String
  createdAt DateTime @default(now())

  @@index([profileId])
}

// Spaced-repetition queue (SM-2 derived): missed puzzles and lessons that
// deserve a revisit. One row per (profileId, kind, refId).
model ReviewItem {
  id           String   @id @default(cuid())
  profileId    String   @default("me")
  kind         String // puzzle | lesson
  refId        String
  concept      String?
  ease         Float    @default(2.5)
  intervalDays Float    @default(0)
  reps         Int      @default(0)
  lapses       Int      @default(0)
  dueAt        DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([profileId, kind, refId])
}

// Per-concept mastery for the skill model. Concepts use the shared taxonomy
// in src/content/schema.ts (CONCEPTS).
model SkillMastery {
  id        String   @id @default(cuid())
  profileId String   @default("me")
  concept   String
  mastery   Float    @default(0) // 0..1
  attempts  Int      @default(0)
  correct   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([profileId, concept])
}

// One finished Puzzle Battle: 5 rounds head to head against a bot on the
// same positions. Casual mode: puzzle Elo and PuzzleAttempt are untouched,
// only an honest match record and small XP live here.
model BattleRecord {
  id        String   @id @default(cuid())
  profileId String   @default("me")
  botId     String
  botName   String
  you       Int
  bot       Int
  result    String // win | loss | draw
  rounds    Int
  dayKey    String
  createdAt DateTime @default(now())

  @@index([profileId])
}

// Training material generated by the coach AI and verified before it ever
// reaches the student. One row per generated artifact, scoped to a profile.
model CoachArtifact {
  id            String   @id @default(cuid())
  profileId     String
  kind          String // puzzle | drill | quiz
  title         String
  fen           String? // null for plain quizzes
  solution      String? // space-separated SAN line (puzzle/drill)
  sideToMove    String? // w | b
  question      String? // quiz question
  payloadJson   String? // quiz options, hint, goal, explanation
  themes        String   @default("[]") // json array of concept ids
  rating        Int? // calibrated difficulty for puzzle/drill
  levelRef      String? // curriculum anchor, e.g. "beginner:5" or tier id
  engineVerified Boolean @default(false)
  attempts      Int      @default(0)
  solved        Boolean?
  createdAt     DateTime @default(now())

  @@index([profileId])
}

// One finished coordinates sprint (vision training): find named squares on a
// bare board against the clock. Three perspectives: white, black, both.
model VisionRun {
  id        String   @id @default(cuid())
  profileId String   @default("me")
  mode      String // white | black | both
  score     Int
  mistakes  Int
  seconds   Int
  dayKey    String
  createdAt DateTime @default(now())

  @@index([profileId])
}

// A position the student kept ("Save it. Play it another way."): paste a FEN
// or set up a board, save it, then play it against any bot from either side.
model SavedPosition {
  id        String   @id @default(cuid())
  profileId String   @default("me")
  name      String
  fen       String
  createdAt DateTime @default(now())

  @@index([profileId, createdAt])
}

// What's new: published changelog entries. Admin-authored only; every player
// (and anonymous visitors, via the ip-derived voter key) can react to them.
model ChangelogEntry {
  id        String   @id @default(cuid())
  title     String
  body      String
  tag       String   @default("update") // update | feature | fix | benchmark
  version   String?
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  reactions ChangelogReaction[]

  @@index([createdAt])
}

// One reaction per viewer per entry. voterKey is the userId when signed in,
// else sha256(ip + server salt). A stored row with a different emoji is
// switched in place; pressing the same emoji again removes it.
model ChangelogReaction {
  id        String         @id @default(cuid())
  entryId   String
  entry     ChangelogEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  voterKey  String
  emoji     String         @default("🎉")
  createdAt DateTime       @default(now())

  @@unique([entryId, voterKey])
}

// Public feature-suggestion board. Status mirrors the roadmap ladder; votes
// are denormalized for sorting and kept exact against SuggestionVote rows.
model FeatureSuggestion {
  id         String   @id @default(cuid())
  profileId  String?
  authorName String   @default("Player")
  title      String
  detail     String
  status     String   @default("open") // open | planned | in_progress | shipped | declined
  votes      Int      @default(0)
  createdAt  DateTime @default(now())

  suggestionVotes SuggestionVote[]

  @@index([status, votes])
}

// One vote per viewer per suggestion (voterKey = profile id when signed in).
model SuggestionVote {
  id           String            @id @default(cuid())
  suggestionId String
  suggestion   FeatureSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  voterKey     String
  createdAt    DateTime          @default(now())

  @@unique([suggestionId, voterKey])
}

// Woodpecker method: one fixed puzzle set per theme. The player replays the
// SAME set cycle after cycle, chasing a faster time; the next cycle unlocks
// only on a run that is quicker than the best AND at least as accurate.
// idsJson holds the exact set composition (bank puzzle ids) so every cycle
// faces the identical positions; grading stays server-side via the standard
// puzzle-move pipeline, so solutions never live on the client.
model WoodpeckerSet {
  id           String    @id @default(cuid())
  profileId    String    @default("me")
  theme        String // app concept id from PUZZLE_THEMES (e.g. "fork")
  kind         String    @default("lichess") // bank source: lichess | curated
  idsJson      String    @default("[]") // ordered puzzle ids forming the fixed set
  size         Int // number of puzzles in the set
  cycle        Int       @default(1) // current playable cycle
  bestMs       Int? // fastest completed cycle
  bestAccuracy Float? // best accuracy (0-100) of a completed cycle
  lastRunAt    DateTime?
  createdAt    DateTime  @default(now())

  @@unique([profileId, theme])
}

// Chess DNA history: one row per profile per day (UTC), written by
// /api/dna when it computes a report. The UI replays these rows as trend
// lines so the player sees each domain moving over weeks — a DNA report
// frozen at one instant can't show whether the training is working.
model DnaSnapshot {
  id          String   @id @default(cuid())
  profileId   String
  dayKey      String // yyyy-mm-dd (UTC)
  games       Int // analyzed games backing this snapshot
  domainsJson String // {tactics:..,consistency:..,opening:..,aggression:..,endgame:..} — null = not measurable that day
  createdAt   DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, dayKey])
  @@index([profileId, createdAt])
}
