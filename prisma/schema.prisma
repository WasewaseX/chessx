generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Registered account. Credentials only; all learning data hangs off Profile.
model User {
  id            String   @id @default(cuid())
  email         String   @unique // stored lowercase
  username      String // display form
  usernameLower String   @unique // case-insensitive uniqueness
  passwordHash  String // bcrypt for password accounts, "oauth:<random>" for Google-only accounts
  role          String   @default("user") // user | admin
  googleId      String?  @unique // Google account subject, set when linked
  createdAt     DateTime @default(now())

  sessions      Session[]
  tickets       SocketTicket[]
  ratings       UserRating[]
  gamesAsWhite  OnlineGame[]   @relation("gameWhite")
  gamesAsBlack  OnlineGame[]   @relation("gameBlack")
  profile       Profile?
}

// Server-side session store. The cookie holds a random token; the DB holds
// its SHA-256 hash, so a DB leak never yields usable cookies.
model Session {
  id        String   @id // sha256(token)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Short-lived single-use credential that lets the websocket service confirm
// who is connecting without ever exposing the session cookie to JS.
model SocketTicket {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// The single account Elo. Every rated online game moves it, whatever the
// time control; bot play and puzzles never touch it (they feed the separate
// potential estimate on Profile instead).
model UserRating {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pool       String // always 'overall'
  rating     Float     @default(400)
  rd         Float     @default(350)
  wins       Int       @default(0)
  losses     Int       @default(0)
  draws      Int       @default(0)
  games      Int       @default(0)
  lastGameAt DateTime?

  @@unique([userId, pool])
}

// A real online game between two accounts.
model OnlineGame {
  id          String    @id
  whiteId     String?
  white       User?     @relation("gameWhite", fields: [whiteId], references: [id], onDelete: SetNull)
  blackId     String?
  black       User?     @relation("gameBlack", fields: [blackId], references: [id], onDelete: SetNull)
  whiteName   String
  blackName   String
  pool        String // bullet | blitz | rapid
  initialSec  Int
  incSec      Int
  rated       Boolean   @default(true)
  result      String    @default("*") // "1-0" | "0-1" | "1/2-1/2" | "*"
  termination String? // checkmate | resignation | timeout | stalemate | agreement | repetition | insufficient | fifty | abandonment
  whiteDelta  Int?
  blackDelta  Int?
  whiteRating Float? // after the game
  blackRating Float?
  pgn         String    @default("")
  createdAt   DateTime  @default(now())
  endedAt     DateTime?

  @@index([whiteId])
  @@index([blackId])
}

model Profile {
  id             String   @id @default(cuid())
  userId         String?  @unique
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String   @default("Player")
  skillLevel     String   @default("beginner") // new | beginner | intermediate | advanced | expert
  coach          String   @default("") // chosen coach id, empty until the player picks one themselves
  onboarded      Boolean  @default(false)
  theme          String   @default("green") // board theme: green | brown | slate | walnut
  darkMode       String   @default("system") // light | dark | system
  soundEnabled   Boolean  @default(true)
  showCoords     Boolean  @default(true)
  showLegal      Boolean  @default(true)
  autoPromote    Boolean  @default(false)
  xp             Int      @default(0)
  // puzzle rating
  puzzleRating   Int?
  puzzleCount    Int      @default(0)
  puzzleStreak   Int      @default(0)
  bestPuzzleStreak Int    @default(0)
  puzzleSolved   Int      @default(0)
  puzzleFailed   Int      @default(0)
  dailyDoneDate  String?  // yyyy-mm-dd of last completed daily puzzle (user tz)
  // bot games are casual; they feed an estimated Elo exactly like chess.com
  // does for bot play: standard Elo (K=32) against each bot's fixed rating.
  botGames       Int      @default(0)
  botElo         Int      @default(0) // 0 until the first bot game seeds it
  botEloGames    Int      @default(0)
  // daily goal + rush bests
  goalMinutes    Int      @default(15)
  rushBest3m     Int      @default(0)
  rushBestSurvival Int    @default(0)
  // AI provider settings (BYO API)
  aiProvider     String   @default("builtin") // builtin | openai | anthropic | gemini | openrouter | groq | deepseek | custom
  aiBaseUrl      String?
  aiApiKey       String?
  aiModel        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model GameRecord {
  id          String   @id @default(cuid())
  profileId   String   @default("me")
  color       String // w | b
  botLevel    Int // 1-14
  botName     String
  rated       Boolean  @default(false)
  result      String // win | loss | draw
  reason      String // checkmate | resign | stalemate | insufficient | repetition | fifty | agreement | abandoned
  pgn         String
  finalFen    String
  moveCount   Int
  ratingDelta Int?
  accuracy    Float?
  // game report v1: filled when the player runs a review on this game
  opening     String?
  whiteAcc    Float?
  blackAcc    Float?
  playerAcc   Float?
  labelsJson  String? // per-side label counts, {best:{w,b},...}
  localHour   Int? // player's local hour (0-23) when the game ended, for time-of-day insights
  analyzedAt  DateTime?
  createdAt   DateTime @default(now())
}

model LessonProgress {
  id            String   @id @default(cuid())
  profileId     String   @default("me")
  lessonId      String
  completed     Boolean  @default(false)
  stepsDone     Int      @default(0)
  totalSteps    Int      @default(0)
  hintsUsed     Int      @default(0)
  completedAt   DateTime?
  updatedAt     DateTime @updatedAt

  @@unique([profileId, lessonId])
}

model PuzzleAttempt {
  id         String   @id @default(cuid())
  profileId  String   @default("me")
  puzzleId   String
  kind       String   @default("rated") // rated | daily | review
  solved     Boolean
  ratingDelta Int?
  dayKey     String? // for daily: yyyy-mm-dd
  createdAt  DateTime @default(now())
}

// One row per calendar day the player was active. id is (profileId + dayKey).
model ActivityDay {
  id            String   @id // profileId:yyyy-mm-dd (user tz)
  profileId     String   @default("me")
  dayKey        String   // yyyy-mm-dd (user tz)
  minutes       Int      @default(0) // active minutes, heartbeats from the client
  puzzlesSolved Int      @default(0)
  lessonSteps   Int      @default(0)
  gamesPlayed   Int      @default(0)
  goalMet       Boolean  @default(false)
  updatedAt     DateTime @updatedAt
}

// Completed Puzzle Rush runs.
model RushRun {
  id        String   @id @default(cuid())
  profileId String   @default("me")
  mode      String // threeMin | survival
  score     Int
  total     Int
  seconds   Int
  dayKey    String
  createdAt DateTime @default(now())
}

// Spaced-repetition queue (SM-2 derived): missed puzzles and lessons that
// deserve a revisit. One row per (profileId, kind, refId).
model ReviewItem {
  id           String   @id @default(cuid())
  profileId    String   @default("me")
  kind         String // puzzle | lesson
  refId        String
  concept      String?
  ease         Float    @default(2.5)
  intervalDays Float    @default(0)
  reps         Int      @default(0)
  lapses       Int      @default(0)
  dueAt        DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([profileId, kind, refId])
}

// Per-concept mastery for the skill model. Concepts use the shared taxonomy
// in src/content/schema.ts (CONCEPTS).
model SkillMastery {
  id        String   @id @default(cuid())
  profileId String   @default("me")
  concept   String
  mastery   Float    @default(0) // 0..1
  attempts  Int      @default(0)
  correct   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([profileId, concept])
}
