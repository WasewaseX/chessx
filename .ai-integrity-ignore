# AI-integrity ignore list for ChessX.
#
# Only VENDORED third-party artifacts and non-shipped trees belong here
# (their code was not written in this repo and is never hand-edited):
#   public/engine/stockfish.js  the minified Stockfish WASM engine build
#   engine-native/              Stockfish source checkout (research; not in git)
#   re/                         REA extraction artifacts (not in git)
#   skills/, download/, research/  platform/session trees (not in git)
# First-party code (src/, mini-services/, scripts/, .zscripts/) is always
# scanned - keep it that way.
public/engine/stockfish.js
engine-native/**
re/**
skills/**
download/**
research/**
# Next.js route files each carry the same auth-guard line and the same
# framework imports by design (65 routes and counting); the duplication
# detector reads framework idiom as copy-paste. The guard itself IS the
# shared helper's call site - it lives in src/lib/auth.ts.
check:boilerplate-duplication:src/app/api/**
check:boilerplate-duplication:scripts/**
# Vendored Stockfish C++ sources repeat the upstream license header in
# every file by upstream convention; not our boilerplate to refactor.
check:boilerplate-duplication:engine-native/**
